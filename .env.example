# Server
PORT=8080

# Database
DB_URL=jdbc:postgresql://localhost:5432/dismal_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Security
JWT_SECRET=BASE64_SECRET
JWT_EXPIRATION_MS=86400000
AES_KEY=BASE64_AES_KEY

# Admin
ADMIN_IMPORT_DEFAULT_PASSWORD=CHANGE_ME
ADMIN_AR_BLOCK_DAYS=30
ADMIN_RESET_PASSWORD_ENABLED=false

# n8n
N8N_WEBHOOK_URL=
N8N_SECRET=

# DismalCRM
DISMAL_CRM_ENABLED=false
# Active esta integracion solo despues de configurar el token API de DismalCRM.
DISMAL_CRM_BASE_URL=https://crm.dismal.vip
# Debe coincidir con INTEGRATION_API_TOKEN en DismalCRM.
DISMAL_CRM_API_TOKEN=
DISMAL_CRM_WHATSAPP_ENABLED=false
DISMAL_CRM_WHATSAPP_ID=34
DISMAL_CRM_WHATSAPP_ID_BY_COUNTRY=EC:34,PE:35

# WordPress / WooCommerce bridge
WOOCOMMERCE_API_KEY=change-this-long-secret

# Sales targets
SALES_FIXED_COST_GLOBAL=300
SALES_FIXED_COST_MODE=GLOBAL

# Outbox
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_DISPATCH_RATE_MS=5000
OUTBOX_DISPATCH_MAX_ATTEMPTS=10

# SMTP
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Invoices / notifications
INVOICE_PDF_BASE_URL=
AR_OVERDUE_CRON=0 10 2 * * *

# CORS (public storefronts and backoffice only; do not use * in production)
CORS_ALLOWED_ORIGINS=https://dismal.net,https://www.dismal.net,https://dismal.net.pe,https://www.dismal.net.pe,https://dismal.vip,https://www.dismal.vip

# Customer account email links
ACCOUNT_EC_STOREFRONT_URL=https://www.dismal.net
ACCOUNT_PE_STOREFRONT_URL=https://www.dismal.net.pe

# Easypanel / Traefik production routing
EASYPANEL_PROXY_NETWORK=easypanel
EASYPANEL_TRAEFIK_SERVICE=easypanel-traefik
EASYPANEL_HTTP_ENTRYPOINT=http
EASYPANEL_HTTPS_ENTRYPOINT=https
EASYPANEL_CERT_RESOLVER=letsencrypt
EASYPANEL_TRAEFIK_CONFIG_DIR=/etc/easypanel/traefik/config
