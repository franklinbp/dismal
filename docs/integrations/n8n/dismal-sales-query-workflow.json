      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl + '/api/v1/auth/authenticate' }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({ email: $json.email, password: $json.password }) }}",
        "options": {}
      },
      "id": "http-auth-1",
      "name": "Authenticate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $item(0).$node['Config'].json.baseUrl + '/api/v1/reports/sales' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$json.token}}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "startDate",
              "value": "={{ $item(0).$node['Config'].json.startDate }}"
            },
            {
              "name": "endDate",
              "value": "={{ $item(0).$node['Config'].json.endDate }}"
            },
            {
              "name": "period",
              "value": "={{ $item(0).$node['Config'].json.period }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-sales-1",
      "name": "Get Sales Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const report = $json;\nconst points = Array.isArray(report.dataPoints) ? report.dataPoints : [];\nconst normalizedPoints = points.map((point) => ({\n  label: point.label ?? point.period ?? point.date ?? '',\n  totalSales: Number(point.totalSales ?? point.total ?? 0),\n}));\nconst totalSales = normalizedPoints.reduce((sum, point) => sum + point.totalSales, 0);\nconst averageSales = normalizedPoints.length ? totalSales / normalizedPoints.length : 0;\nconst topPoint = normalizedPoints.reduce((best, point) => {\n  if (!best || point.totalSales > best.totalSales) {\n    return point;\n  }\n  return best;\n}, null);\n\nreturn [{\n  json: {\n    source: 'Dismal',\n    startDate: report.startDate,\n    endDate: report.endDate,\n    period: report.period,\n    totalBuckets: normalizedPoints.length,\n    totalSales,\n    averageSales,\n    topBucket: topPoint,\n    dataPoints: normalizedPoints,\n    rawReport: report,\n  }\n}];"
      },
      "id": "code-summary-1",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        300
      ]
    }
  ],
